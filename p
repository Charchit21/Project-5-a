  class GraphQLHelper {
    // graphql id 前缀
    static variantIdPrefix = 'gid://shopify/ProductVariant/';
    // graphql 请求地址
    static apiVersion = '2024-10';
    //  storefront app
    static appSecretKey = '7bb184c4d18313c58d0ccd6bfa0f73a3';
    static authHeaders() {
      return {
        'x-shopify-storefront-access-token': GraphQLHelper.appSecretKey,
      };
    }
    /**
     * 前端 Id 转 graphql id
     * @param { string } id 前端 id
     */
    static graphqlVariantId(id) {
      return GraphQLHelper.variantIdPrefix + id;
    }

    /**
     * graphql id 转 前端 Id
     * @param { string } id graphql id
     */
    static storeVariantId(id) {
      return id.replace(GraphQLHelper.variantIdPrefix, '');
    }

    /**
     * 查询请求
     * @param { string } query  query 参数
     * @param { json } variables 变量
     */
    static query(query, variables) {
      if (!GraphQLHelper.appSecretKey) {
        console.error(`GraphQLHelper: empty appSecretKey`);
        return;
      }
      if (!GraphQLHelper.apiVersion) {
        console.error(`GraphQLHelper: empty apiVersion`);
        return;
      }

      const apiUrl = `/api/${GraphQLHelper.apiVersion}/graphql.json`;
      return fetch(apiUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          ...GraphQLHelper.authHeaders(),
        },
        body: JSON.stringify({ query, variables }),
      })
        .then((response) => {
          if (response.ok) {
            return response.json();
          } else {
            throw { message: `${response.status}: ${response.statusText}` };
          }
        })
        .catch((err) => {
          return err.message;
        });
    }
  }
</script>


