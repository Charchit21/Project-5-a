  function handleUrlRedirect() {
    // 获取当前域名
    const currentDomain = window.location.hostname;
    // 获取当前配置
    const config = siteConfigs[currentDomain];

    // 如果找不到对应配置，直接返回
    if (!config) return;

    // 检查当前路径是否匹配
    if (window.location.pathname !== config.sourcePath) return;

    // 获取当前 URL 参数
    const currentUrl = new URL(window.location.href);
    const audience = currentUrl.searchParams.get('audience');

    // 获取其他参数
    const otherParams = new URLSearchParams();
    for (const [key, value] of currentUrl.searchParams) {
      if (key !== 'audience') {
        otherParams.append(key, value);
      }
    }
    const otherParamsStr = otherParams.toString() ? '?' + otherParams.toString() : '';

    let newUrl;
    if (audience === 'smb') {
      newUrl = config.targetUrls.smb + otherParamsStr;
    } else if (audience === 'diy' || !audience) {
      newUrl = config.targetUrls.diy + otherParamsStr;
    } else {
      // 如果 audience 不是 smb 或 diy，可以选择默认跳转到 new_url_b 或其他处理
      newUrl = config.sourcePath + otherParamsStr;
    }
    // 执行重定向
    window.location.href = newUrl;
  }

  try {
    handleUrlRedirect();
  } catch (error) {
    console.error('Redirect error:', error);
  }
