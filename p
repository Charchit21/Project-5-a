  class CookieHelper {
    /**
     * 根据 key 获取 cookie 的值
     */
    static getCookie(key) {
      // 使用正则匹配 key 和其对应的值
      const match = document.cookie.match(new RegExp('(?:^|; )' + encodeURIComponent(key) + '=([^;]*)'));
      return match ? decodeURIComponent(match[1]) : null; // 如果找到则返回值，否则返回 null
    }

    /**
     * 设置 cookie
     */
    static setCookie(key, value, options = {}) {
      const {
        expires = 30, // 过期时间（Date 对象或天数）
        path = '/', // 路径，默认根路径
        domain, // 作用域
        secure, // 是否仅允许 HTTPS
        sameSite = 'Lax', // SameSite 属性
      } = options;

      let cookieString = `${encodeURIComponent(key)}=${encodeURIComponent(value)}`;

      if (expires) {
        if (typeof expires === 'number') {
          const date = new Date();
          date.setTime(date.getTime() + expires * 24 * 60 * 60 * 1000);
          cookieString += `; expires=${date.toUTCString()}`;
        } else if (expires instanceof Date) {
          cookieString += `; expires=${expires.toUTCString()}`;
        }
      }

      if (path) {
        cookieString += `; path=${path}`;
      }

      if (domain) {
        cookieString += `; domain=${domain}`;
      }

      if (secure) {
        cookieString += `; secure`;
      }

      if (sameSite) {
        cookieString += `; samesite=${sameSite}`;
      }

      document.cookie = cookieString;
    }

    /**
     * 删除 cookie
     */
    static deleteCookie(key, options = {}) {
      CookieHelper.setCookie(key, '', { ...options, expires: -1 });
    }
  }
</script>


