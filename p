<script id="scarab-cart" type="module">
  $(function () {
    // 购物车变化埋点
    document.addEventListener('on::cart::change', async event => {
      trackCartItems(event.detail);
    })
  })

  function trackCartItems(cart) {
    const items = cart.items;
    const cartItems = (items instanceof Array ? items : [items]).map(item => {
      return {
        item: String(item.variantId),
        price: item.linePrice, // 多站点时需要将当前的货币按照汇率兑换成USD
        quantity: item.quantity
      }
    })

    ScarabQueue.push(['cart', cartItems]);
    ScarabQueue.push(['go']);
  }
</script>
  

