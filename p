  <div id="shopify-block-Aa1B2Z1poQ2NRRGsxe__10963884705231178394" class="shopify-block shopify-app-block"><script>
  class BuyItNowHandler {
    constructor() {
      if (!CookieHelper) {
        throw new Error('BuyItNowHandler: CookieHelper not found.');
      }
      if (!GraphQLHelper) {
        throw new Error('BuyItNowHandler: GraphQLHelper not found.');
      }
      window.addEventListener(BuyItNowHandler.EVENT_NAME_BUY_IT_NOW, this.buyItNowEventTrigger.bind(this));
      document.addEventListener(BuyItNowHandler.EVENT_NAME_BUY_IT_NOW, this.buyItNowEventTrigger.bind(this));
      console.log(`${BuyItNowHandler.EVENT_NAME_BUY_IT_NOW} 注册成功`);
      this.recoverCart();
      console.log(``);
    }
    static EVENT_NAME_BUY_IT_NOW = 'buy-it-now';
    static CART_COOKIE_KEY = 'cart';
    static OLD_CART_COOKIE_KEY = 'old_cart';
    /**
     * 创建 graphQL 购物车
     * 对应 mutation cartCreate: https://shopify.dev/docs/api/storefront/2024-10/mutations/cartCreate
     * @returns  {
     *  id: string;
     *  checkoutUrl: string
     * }
     */
    async createCart(cartInput) {
      const query = `
        mutation cartCreate($input: CartInput) {
            cartCreate(input: $input) {
                cart {
                    id
                    checkoutUrl
                }
                userErrors {
                    field
                    message
                }
                warnings {
                    message
                }
            }
        }
      `;
      let res = {
        id: ``,
        checkoutUrl: ``,
      };
      try {
        const response = await GraphQLHelper.query(query, {
          input: cartInput,
        });
        if (response.errors) {
          throw response.errors;
        }
        if (response.data.cartCreate.userErrors.length > 0) {
          throw response.data.cartCreate.userErrors;
        }
        const cart = response.data.cartCreate.cart;
        res = {
          id: cart.id,
          checkoutUrl: cart.checkoutUrl,
        };
      } catch (err) {
        console.error(`${BuyItNowHandler.EVENT_NAME_BUY_IT_NOW} create cart: `, err);
      }
      return res;
    }

    /**
     * 向 graphQL 购物车中添加商品
     * 对应 mutation checkoutLineItemAdd
     * @param
     */
    async addItemsGraphql(cartId, lines) {
      const query = `
        mutation cartLinesAdd($cartId: ID!, $lines: [CartLineInput!]!) {
          cartLinesAdd(cartId: $cartId, lines: $lines) {
            cart {
              id
              checkoutUrl
            }
            userErrors {
              field
              message
            }
            warnings {
              message
            }
          }
        }
      `;
      const variables = {
        cartId: cartId,
        lines: lines.map((item) => {
          if (!item.merchandiseId.startsWith('gid')) {
            item.merchandiseId = GraphQLHelper.graphqlVariantId(item.merchandiseId);
          }
          return item;
        }),
      };
      return GraphQLHelper.query(query, variables);
    }

    /**
     * 直接购买
     * @param {
     *      variantId: string; // 变体 id
     *      quantity: number;
     *      properties: {
     *              discountCode: string;
     *          }
     * } item
     */
    async buyItNow(eventDetail) {
      const { lines = [], attributes = [], discountCodes = [], note = '' } = eventDetail;
      console.log(`BuyItNowHandler: cart attributes`, attributes);
      if (!Array.isArray(lines)) {
        console.error(`${BuyItNowHandler.EVENT_NAME_BUY_IT_NOW}: lines must be array`);
        return;
      } else if (lines.length === 0) {
        console.error(`${BuyItNowHandler.EVENT_NAME_BUY_IT_NOW}: lines can not be empty`);
        return;
      }
      const cartInput = {
        attributes,
        discountCodes,
        note,
        lines: lines.map((item) => {
          if (!item.merchandiseId.startsWith('gid')) {
            item.merchandiseId = GraphQLHelper.graphqlVariantId(item.merchandiseId);
          }
          return item;
        }),
      };
      console.log(`cartInput`, JSON.stringify(cartInput));
      // 创建购物车
      const cart = await this.createCart(cartInput);
      console.log(`cart`, cart);

      if (cart.checkoutUrl) {
        // 跳转前先设置 cookie
        this.recordOldCartId();
        window.location.href = cart.checkoutUrl;
      }
    }

    /**
     * 用于绑定事件
     */
    buyItNowEventTrigger(event) {
      if (!event.detail || !event.detail.lines) {
        console.error(`${BuyItNowHandler.EVENT_NAME_BUY_IT_NOW}: lines can not be empty`);
        return;
      }
      this.buyItNow(event.detail);
    }

    /**
     * 记录旧的购物车 id 用于结算完成后的恢复
     */
    recordOldCartId() {
      // 读取当前 cartId
      const oldCartId = CookieHelper.getCookie(BuyItNowHandler.CART_COOKIE_KEY);
      // 写入 old_cart
      CookieHelper.setCookie(BuyItNowHandler.OLD_CART_COOKIE_KEY, oldCartId);
    }

    /**
     * 用旧的购物车 id 恢复购物车
     * 正常结算是否受影响
     */
    recoverCart() {
      const cartId = CookieHelper.getCookie(BuyItNowHandler.CART_COOKIE_KEY);
      const oldCartId = CookieHelper.getCookie(BuyItNowHandler.OLD_CART_COOKIE_KEY);
      if (!oldCartId || cartId === oldCartId) {
        // 不存在、相等，都不处理
        console.log(`BuyItNowHandler: 不需要还原`);
        CookieHelper.deleteCookie(BuyItNowHandler.OLD_CART_COOKIE_KEY);
        console.log(`BuyItNowHandler: 删除 old cart`);
        console.log(`BuyItNowHandler: 当前 old cart -- ${CookieHelper.getCookie(BuyItNowHandler.OLD_CART_COOKIE_KEY)}`);
        return;
      } else {
        // 存在旧 id，并且不相等, 覆盖
        CookieHelper.setCookie(BuyItNowHandler.CART_COOKIE_KEY, oldCartId);
        console.log(`BuyItNowHandler: 覆盖 cartId`);
        CookieHelper.deleteCookie(BuyItNowHandler.OLD_CART_COOKIE_KEY);
        console.log(`BuyItNowHandler: 删除 old cart`);
        // 刷新购物车
        if (theme && theme.Cart && theme.Cart.updateCart) {
          theme.Cart.updateCart();
          console.log(`BuyItNowHandler: 刷新购物车`);
        }
      }
    }
  }

  (function () {
    const butItNowHandler = new BuyItNowHandler();
    if (theme) {
      theme.BuyItNowHandler = butItNowHandler;
    }
  })();
</script>


