<script>
  (function() {
    // 请求黑名单，域名、接口名称等
    const blackList = [
      'https://monorail-edge.shopifysvc.com',
    ];
    // 延迟请求API
    const delayList = [];
    // 延迟请求接口列表
    let delayFetchList = [];
    // 监听请求接口完成列表
    let requestedList = [
      {
        url: '^/discount/[^/]+$',
        callback: function() {
          document.dispatchEvent(new CustomEvent('on::discount::requested'));
        }
      },
    ];
    // 延迟请求列表是否已经进行
    let fetchFlag = false;

    function isBlackURL(url) {
      if (typeof url !== 'string') {
        return false;
      }
      return blackList.some(item => url.includes(item));
    }
    function isDelayURL(url) {
      if (typeof url !== 'string') {
        return false;
      }
      return delayList.some(item => url.includes(item));
    }
    function matchRequested(url) {
      if (typeof url !== 'string') {
        return null;
      }
      let matchResult = null;
      requestedList.some(item => {
        const regex = new RegExp(item.url);
        if (regex.test(url)) {
          matchResult = item;
          return true;
        }
        return false;
      });
      return matchResult;
    }
    const originFetch = window.fetch;

    const resolveCallback = function(url) {
      try {
        const matchResult = matchRequested(url);
        if (matchResult) {
          matchResult.callback();
        }
      } catch (error) {}
    }

    function createFetchInterceptor() {
      
      window.fetch = function(url, options) {
        // 对于黑名单接口，采用不发送接口请求
        if (isBlackURL(url)) {
          return new Promise(() => {});
        }
        // 延迟接口添加到延迟请求队列中
        if ( !fetchFlag && isDelayURL(url)) {
          return new Promise(function(resolve, reject) {
            delayFetchList.push({
              url,
              options,
              resolve,
              reject,
              type: 'fetch',
            });
          }).then((res)=>{
            resolveCallback(url);
            return res;
          });
        } else {
          return originFetch(url, options).then((res)=>{
            resolveCallback(url);
            return res;
          });
        }
      }
    }

    function createXMLHttpRequestInterceptor() {
      const originXMLHttpRequest = window.XMLHttpRequest;
      
      function InterceptedXMLHttpRequest() {
        const xhr = new originXMLHttpRequest();

        const oldOpen = xhr.open;
        xhr.open = function(method, url, async, user, password) {
          this._url = url;
          // 对于黑名单接口，采用不发送接口请求
          if (isBlackURL(url)) {
            return;
          }
          if (!fetchFlag && isDelayURL(url)) {
            delayFetchList.push({ xhr, method, url, async, user, password });
            return Promise.resolve();
          } else {
            return oldOpen.apply(this, arguments);
          }
        };

        const oldSend = xhr.send;
        xhr.send = function(data) {
          // 对于黑名单接口，采用不发送接口请求
          if (isBlackURL(this._url)) {
            return;
          }
          if (!fetchFlag && isDelayURL(this._url)) {
            // 获取最新请求，添加对应请求参数
            const item = delayFetchList[delayFetchList.length - 1];
            item.data = data;
          } else {
            oldSend.apply(this, arguments);
          }
        };

        xhr.addEventListener('readystatechange', function() {
          if (xhr.readyState === 4) {
            resolveCallback(xhr._url)
          }
        });
        return xhr;
      }
      InterceptedXMLHttpRequest.prototype = Object.create(originXMLHttpRequest.prototype);
      InterceptedXMLHttpRequest.prototype.constructor = InterceptedXMLHttpRequest;

      window.XMLHttpRequest = InterceptedXMLHttpRequest;
    }
    createFetchInterceptor();
    createXMLHttpRequestInterceptor();

    function fetchDelayUrls() {
      if (!fetchFlag) {
        fetchFlag = true;
        delayFetchList.forEach(item => {
          if (item.type === 'fetch') {
            originFetch(item.url, item.options).then(item.resolve, item.reject);
          } else {
            const xhr = item.xhr;
            xhr.open(item.method, item.url, item.async, item.user, item.password);
            xhr.send(data);
          }
        });
        delayFetchList = [];
      }
    }
    window.addEventListener('load', function() {
      fetchDelayUrls();
    });
    setTimeout(() => {
      fetchDelayUrls();
    }, 90000);
  })();
</script>
